{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wyvern-workers-staging",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "wyvern-media-staging"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "wyvern-backups-staging"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "APP_NAME": "Wyvern Workers (Staging)",
    "API_V1_PREFIX": "/api/v1",
    "ENVIRONMENT": "staging",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "15",
    "REFRESH_TOKEN_EXPIRE_DAYS": "30",
    "CORS_ORIGINS": "https://staging.example.invalid",
    "MEDIA_PUBLIC_BASE_URL": "/media",
    "ADMIN_ALLOWLIST": "",
    "SMTP2GO_BASE_URL": "https://api.smtp2go.com/v3",
    "SMTP2GO_DEFAULT_FROM": "noreply-staging@wyvernhub.net",
    "SMTP2GO_DEFAULT_FROM_NAME": "Wyvern Hub Staging",
    "EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES": "15",
    "EMAIL_VERIFICATION_MAX_ATTEMPTS": "5",
    "EMAIL_VERIFICATION_RESEND_SECONDS": "60",
    "EMAIL_VERIFICATION_REQUEST_LIMIT": "5",
    "EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES": "60",
    "EMAIL_VERIFICATION_REQUIRED_VERSION": "0",
    "STRIPE_PRICE_ID": "",
    "STRIPE_SUCCESS_URL": "",
    "STRIPE_CANCEL_URL": "",
    "STRIPE_PORTAL_RETURN_URL": "",
    "SUBSCRIPTIONS_ENABLED": "false",
    "UNIVERSAL_PREMIUM_ACCESS": "true",
    "REGISTRATION_ENABLED": "false",
    "MAINTENANCE_MODE": "false",
    "MAINTENANCE_MESSAGE": "",
    "FEATURE_UPLOADS_ENABLED": "true",
    "FEATURE_WEBHOOKS_ENABLED": "true",
    "FEATURE_COMMUNITY_TOOLS_ENABLED": "true",
    "FEATURE_VOICE_ENABLED": "true",
    "FEATURE_AI_ENABLED": "false",
    "FREE_MAX_UPLOAD_BYTES": "26214400",
    "PREMIUM_MAX_UPLOAD_BYTES": "262144000",
    "FREE_STORAGE_BYTES": "262144000",
    "PREMIUM_STORAGE_BYTES": "10737418240",
    "FREE_UPLOADS_PER_DAY": "20",
    "PREMIUM_UPLOADS_PER_DAY": "100",
    "FREE_WEBHOOKS_PER_SERVER": "5",
    "PREMIUM_WEBHOOKS_PER_SERVER": "25"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE_ROOM",
        "class_name": "PresenceRoom"
      },
      {
        "name": "APP_STATE_ROOM",
        "class_name": "AppStateRoom"
      },
      {
        "name": "REALTIME_HUB",
        "class_name": "RealtimeHub"
      },
      {
        "name": "RATE_LIMIT_ROOM",
        "class_name": "RateLimitRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PresenceRoom", "AppStateRoom", "RealtimeHub"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RateLimitRoom"]
    }
  ]
}
