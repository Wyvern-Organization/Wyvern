APP_NAME=Wyvern Workers
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
JWT_SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=*
MEDIA_PUBLIC_BASE_URL=/media
WYV_PUBLIC_BASE_URL=
WYV_SHARED_SECRET=
MAIL_WORKER_SECRET=
SMTP2GO_API_KEY=
SMTP2GO_BASE_URL=https://api.smtp2go.com/v3
SMTP2GO_DEFAULT_FROM=noreply@wyvernhub.net
SMTP2GO_DEFAULT_FROM_NAME=Wyvern Hub
EMAIL_VERIFICATION_CODE_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_REQUEST_LIMIT=5
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MINUTES=60
# Raise this integer to require every existing account to verify again. New
# successful code verifications record the active version. Use 0 to disable.
EMAIL_VERIFICATION_REQUIRED_VERSION=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
SUBSCRIPTIONS_ENABLED=false
UNIVERSAL_PREMIUM_ACCESS=true
ADMIN_ALLOWLIST=
MALWARE_SCANNER_URL=
MALWARE_SCANNER_SECRET=

# Deployment startup defaults. Persisted admin runtime controls override only the
# registration, maintenance, and feature-toggle values after the app has state.
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
FEATURE_UPLOADS_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_COMMUNITY_TOOLS_ENABLED=true
FEATURE_VOICE_ENABLED=true
FEATURE_AI_ENABLED=false

# Email-verification and tier limits are deployment configuration.
# The email request limit applies per account and client IP in the time window.
# Tier byte values use binary MiB/GiB units.
FREE_MAX_UPLOAD_BYTES=26214400
PREMIUM_MAX_UPLOAD_BYTES=262144000
FREE_STORAGE_BYTES=262144000
PREMIUM_STORAGE_BYTES=10737418240
FREE_UPLOADS_PER_DAY=20
PREMIUM_UPLOADS_PER_DAY=100
FREE_WEBHOOKS_PER_SERVER=5
PREMIUM_WEBHOOKS_PER_SERVER=25
